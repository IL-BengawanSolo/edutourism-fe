# EduSolo FE — Environment template
# Local dev:  cp .env.example .env.development.local  (VITE_API_BASE_URL=http://localhost:5500/api/v1)
# Production: set VITE_API_BASE_URL in Vercel Dashboard → Environment Variables (Production)
# Only 2 files: .env.example (committed) + .env.development.local (ignored)
VITE_API_BASE_URL=https://edusolo-general-api.vercel.app/api/v1
